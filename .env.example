# Sao chép thành .env trước khi chạy docker compose. Đổi các giá trị bí mật khi triển khai thật.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Tối thiểu 32 ký tự, phải giống nhau giữa API và ONLYOFFICE.
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-secret-0123456789abcdef
ADMIN_API_KEY=change-me-admin-key
