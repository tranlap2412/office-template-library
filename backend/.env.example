# Sao chép thành .env khi chạy backend ngoài Docker.
PORT=5080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/office_templates
TEMPLATES_ROOT=../templates
DOCUMENTS_ROOT=data/documents
PREVIEWS_ENABLED=true
ADMIN_API_KEY=dev-admin-key-change-me
CORS_ORIGINS=http://localhost:5173
# Trình soạn thảo ONLYOFFICE (để false nếu chưa chạy Document Server)
ONLYOFFICE_ENABLED=false
ONLYOFFICE_PUBLIC_URL=http://localhost:8081
ONLYOFFICE_INTERNAL_URL=http://localhost:8081
ONLYOFFICE_API_BASE_URL=http://host.docker.internal:5080
ONLYOFFICE_JWT_SECRET=
